{
  "name": "@zaptunnel/sdk",
  "version": "0.2.0",
  "description": "End-to-end encrypted browser connections to Core Lightning through Zaptunnel",
  "license": "MIT",
  "homepage": "https://zapptunnel.com/#sdk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niftynei/zaptunnel.git",
    "directory": "sdk"
  },
  "bugs": {
    "url": "https://github.com/niftynei/zaptunnel/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    }
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "test": "pnpm build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "lnmessage": "0.2.9"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "svelte": "^5.56.9",
    "svelte-check": "^4.7.6",
    "typescript": "~5.9.3",
    "vite": "~7.1.0"
  }
}
